<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- geral -->

    <style name="Widget.Ouros.Button.Base" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Ouros.Button.Tiny" parent="Widget.Ouros.Button.Base">
        <item name="android:layout_width">95dp</item>
        <item name="android:layout_height">37dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Ouros.Button.Medium" parent="Widget.Ouros.Button.Base">
        <item name="android:layout_width">322dp</item>
        <item name="android:layout_height">39dp</item>
        <item name="android:textSize">15sp</item>

    </style>

    <style name="Widget.Ouros.Button.Big" parent="Widget.Ouros.Button.Base">
        <item name="android:layout_width">352dp</item>
        <item name="android:layout_height">39dp</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
    </style>




    <!-- botões -->

    <style name="Widget.Ouros.Button.Tiny.Gold" parent="Widget.Ouros.Button.Tiny">
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Widget.Ouros.Button.Tiny.Blue" parent="Widget.Ouros.Button.Tiny">
        <item name="backgroundTint">@color/blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Ouros.Button.Medium.Gold" parent="Widget.Ouros.Button.Medium">
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Widget.Ouros.Button.Medium.Outlined" parent="Widget.Ouros.Button.Medium">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/black</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.Ouros.Button.Big.Blue" parent="Widget.Ouros.Button.Big">
        <item name="backgroundTint">@color/blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

</resources>