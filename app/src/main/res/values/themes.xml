<resources>

    <style name="Theme.Ouros.Starting" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <item name="android:windowSplashScreenBackground">@color/ouros_splash_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ouros_logo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Ouros" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout.Gold</item>
    </style>

</resources>
