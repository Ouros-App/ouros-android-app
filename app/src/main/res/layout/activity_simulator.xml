<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F9"
    tools:context=".feature.secondary.simulator.SimulatorActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/simulatorContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="40dp"
            android:paddingEnd="30dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSimulatorConsumption"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:clipToOutline="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/kpi_medium_bg"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/txtSimulatorConsumption"
                            style="@style/subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:maxLines="1"
                            android:text="--"
                            android:textColor="@color/white"
                            android:textSize="35sp"
                            tools:text="6.07" />

                        <TextView
                            style="@style/text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Consumo"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSimulatorEnergy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:clipToOutline="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/kpi_medium_bg"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/txtSimulatorEnergy"
                            style="@style/subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:maxLines="1"
                            android:text="--"
                            android:textColor="@color/white"
                            android:textSize="35sp"
                            tools:text="5.2" />

                        <TextView
                            style="@style/text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="kWh/ave"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSimulatorSavings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:clipToOutline="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/kpi_medium_bg"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/txtSimulatorSavings"
                            style="@style/subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="27sp"
                            android:autoSizeMinTextSize="18sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:gravity="bottom"
                            android:maxLines="1"
                            android:text="R$ 0"
                            android:textColor="@color/white"
                            tools:text="R$ 1.022" />

                        <TextView
                            style="@style/text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Economia"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSimulatorPositions"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:clipToOutline="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/kpi_medium_bg"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/txtSimulatorPositions"
                            style="@style/subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:maxLines="1"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="35sp"
                            tools:text="8" />

                        <TextView
                            style="@style/text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Posições"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCurrentCgi"
            style="@style/Widget.App.TextInputLayout.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Consumo atual"
            app:suffixText="CGI">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCurrentCgi"
                style="@style/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTargetCgi"
            style="@style/Widget.App.TextInputLayout.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Consumo alvo"
            app:suffixText="CGI">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTargetCgi"
                style="@style/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutWaterPrice"
            style="@style/Widget.App.TextInputLayout.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Preço por m³ da água"
            app:prefixText="R$">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputWaterPrice"
                style="@style/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEnergyPrice"
            style="@style/Widget.App.TextInputLayout.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Preço da energia"
            app:prefixText="R$">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEnergyPrice"
                style="@style/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutChickens"
            style="@style/Widget.App.TextInputLayout.Gold"
            android:hint="Quantidade de aves">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputChickens"
                style="@style/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTargetEnergy"
            style="@style/Widget.App.TextInputLayout.Gold"
            android:hint="Gasto alvo de energia por ave"
            app:suffixText="kWh">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTargetEnergy"
                style="@style/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/buttonSimulator"
            style="@style/Widget.Ouros.Button.Big.Blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Simular" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/header"
        style="@style/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="Simulador"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-18dp"
        android:layout_marginTop="-5dp"
        app:layout_constraintStart_toEndOf="@+id/header"
        app:layout_constraintTop_toTopOf="@+id/header"
        app:srcCompat="@drawable/ouros_goldwings" />

    <ImageView
        android:id="@+id/btnSimulatorBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="5dp"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header"
        app:srcCompat="@drawable/ic_arrow_left" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/simulatorError"
            style="@style/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="gone"
            tools:text="Não foi possível carregar o simulador."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/simulatorRetry"
            style="@style/Widget.Ouros.Button.Medium.Gold"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:minWidth="160dp"
            android:text="Tentar novamente"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/simulatorLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F4F7F9"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/blue"
            app:trackColor="#E3E7EA" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
