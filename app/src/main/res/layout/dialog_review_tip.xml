<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="266dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtReviewDialogTitle"
                style="@style/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:includeFontPadding="false"
                android:text="Avaliar dica" />

            <!-- 5 Star Rating Row -->
            <LinearLayout
                android:id="@+id/starContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/star1"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="1dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="1 estrela"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:id="@+id/star2"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="1dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="2 estrelas"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:id="@+id/star3"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="1dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="3 estrelas"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:id="@+id/star4"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="1dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="4 estrelas"
                    android:src="@drawable/ic_star_half" />

                <ImageView
                    android:id="@+id/star5"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="1dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="5 estrelas"
                    android:src="@drawable/ic_star_border" />

            </LinearLayout>

            <EditText
                android:id="@+id/editComment"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_review_comment_input"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical|start"
                android:hint="Comentário"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:inputType="textCapSentences"
                android:letterSpacing="-0.03"
                android:paddingHorizontal="18dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="#717171"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSubmitReview"
                    style="@style/Widget.Ouros.Button.Tiny.Gold"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#23EA47"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="0dp"
                    android:text="Enviar"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    app:cornerRadius="18dp" />

                <Button
                    android:id="@+id/btnCancelReview"
                    style="@style/Widget.Ouros.Button.Tiny.Gold"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.15"
                    android:backgroundTint="@color/warning_red"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="0dp"
                    android:text="Cancelar"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    app:cornerRadius="18dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
