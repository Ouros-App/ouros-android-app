<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.auth.firstaccess.FirstAccessPageFragment">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Voltar"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_arrow_left" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="Etapa 2 de 4"
            app:srcCompat="@drawable/stages_2" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/firstAccessCodeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:isScrollContainer="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnResendCode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayout3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/linearLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_marginTop="72dp"
                android:layout_marginEnd="50dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textCodeTitle"
                    style="@style/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Agora, o código de verificação!" />

                <TextView
                    android:id="@+id/textCodeDescription"
                    style="@style/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Enviamos um código temporário para o e-mail registrado." />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/codeInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="70dp"
                android:layout_marginEnd="30dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCodeDigitOne"
                        style="@style/Widget.Ouros.VerificationCodeInput"
                        android:autofillHints="smsOTPCode"
                        android:importantForAutofill="yes" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCodeDigitTwo"
                        style="@style/Widget.Ouros.VerificationCodeInput"
                        android:importantForAutofill="no" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCodeDigitThree"
                        style="@style/Widget.Ouros.VerificationCodeInput"
                        android:importantForAutofill="no" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCodeDigitFour"
                        style="@style/Widget.Ouros.VerificationCodeInput"
                        android:importantForAutofill="no" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCodeDigitFive"
                        style="@style/Widget.Ouros.VerificationCodeInput"
                        android:importantForAutofill="no" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCodeDigitSix"
                        style="@style/Widget.Ouros.VerificationCodeInput"
                        android:importantForAutofill="no" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/textCodeError"
                style="@style/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="30dp"
                android:textColor="@color/warning_red"
                android:visibility="gone"
                tools:text="Informe os 6 números do código."
                tools:visibility="visible" />

            <Button
                android:id="@+id/btnContinue"
                style="@style/Widget.Ouros.Button.Big.Blue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="30dp"
                android:text="Continuar" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/btnResendCode"
        style="@style/text"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="Não recebeu? Reenviar"
        android:textColor="@color/blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
