<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F9"
    tools:context=".feature.main.goals.GoalsFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/goalsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="invisible"
        tools:visibility="visible"

        android:paddingBottom="170dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="64dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="170dp">

                <FrameLayout
                    android:id="@+id/progressCircleContainer"
                    android:layout_width="158dp"
                    android:layout_height="158dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressGoals"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="56"
                        app:indicatorColor="#19109D"
                        app:indicatorDirectionCircular="clockwise"
                        app:indicatorInset="5dp"
                        app:indicatorSize="148dp"
                        app:trackColor="#F0DDB5"
                        app:trackThickness="18dp" />

                    <TextView
                        android:id="@+id/textProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="56%"
                        android:textColor="#010B13"
                        android:textSize="34sp" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/progressInformation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/progressCircleContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/progressCircleContainer"
                    app:layout_constraintTop_toTopOf="@id/progressCircleContainer">

                    <TextView
                        android:id="@+id/textProgressCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="-2dp"
                        android:text="5 de 9&#10;metas completadas"
                        android:textColor="#010B13"
                        android:textSize="15sp"
                        tools:text="5 de 9&#10;metas completadas" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/linearProgressGoals"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="56"
                        app:indicatorColor="#19109D"
                        app:trackColor="#F0DDB5"
                        app:trackCornerRadius="5dp"
                        app:trackThickness="10dp" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:text="Metas Pessoais"
                    android:textColor="#010B13"
                    android:textSize="22sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAddGoal"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    app:backgroundTint="#010B13"
                    app:cornerRadius="16dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPersonalGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="7"
                tools:listitem="@layout/item_goal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="Metas Estaduais"
                android:textColor="#010B13"
                android:textSize="22sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerStateGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="2"
                tools:listitem="@layout/item_goal" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/goalsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#010B13"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Não foi possível carregar as metas."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goalsRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:minWidth="160dp"
            android:text="Tentar novamente"
            android:textAllCaps="false"
            android:textColor="#010B13"
            android:textSize="15sp"
            android:visibility="gone"
            app:backgroundTint="#D8A23A"
            app:cornerRadius="12dp"
            tools:visibility="visible" />

    </LinearLayout>

    <com.ouros.app.core.SkeletonLoaderView
        android:id="@+id/goalsLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4F7F9"
        android:contentDescription="Carregando metas"
        android:visibility="gone" />

</FrameLayout>