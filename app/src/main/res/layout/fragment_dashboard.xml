<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="140dp"
        android:scrollbars="none"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="25dp"
            android:paddingTop="60dp"
            android:paddingEnd="25dp">

            <!-- 3 Cards Rápidos de Indicadores (KPIs) -->
            <LinearLayout
                android:id="@+id/layoutDashboardKpis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 1: Consumo Geral -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardKpiConsumption"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_rank_card_gradient"
                        android:gravity="bottom|start"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/txtKpiConsumptionValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.06"
                            android:maxLines="1"
                            android:text="6.07"
                            android:textColor="@color/white"
                            android:textSize="32sp"
                            app:autoSizeMaxTextSize="35sp"
                            app:autoSizeMinTextSize="22sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:id="@+id/txtKpiConsumptionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.05"
                            android:maxLines="1"
                            android:text="Consumo"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            app:autoSizeMaxTextSize="16sp"
                            app:autoSizeMinTextSize="11sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Eficiência Hídrica -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardKpiWater"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_rank_card_gradient"
                        android:gravity="bottom|start"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/txtKpiWaterValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.06"
                            android:maxLines="1"
                            android:text="5.2"
                            android:textColor="@color/white"
                            android:textSize="32sp"
                            app:autoSizeMaxTextSize="35sp"
                            app:autoSizeMinTextSize="22sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:id="@+id/txtKpiWaterLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.05"
                            android:maxLines="1"
                            android:text="Litros/ave"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            app:autoSizeMaxTextSize="16sp"
                            app:autoSizeMinTextSize="11sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 3: Eficiência Energética -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardKpiEnergy"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_rank_card_gradient"
                        android:gravity="bottom|start"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/txtKpiEnergyValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.06"
                            android:maxLines="1"
                            android:text="8.1"
                            android:textColor="@color/white"
                            android:textSize="32sp"
                            app:autoSizeMaxTextSize="35sp"
                            app:autoSizeMinTextSize="22sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:id="@+id/txtKpiEnergyLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.05"
                            android:maxLines="1"
                            android:text="kWh/ave"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            app:autoSizeMaxTextSize="16sp"
                            app:autoSizeMinTextSize="11sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Seção Gráfico: Consumo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="-0.06"
                android:text="Consumo"
                android:textColor="#010B13"
                android:textSize="22sp" />

            <WebView
                android:id="@+id/chartConsumption"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <!-- Seção Gráfico: Água -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="-0.06"
                android:text="Água"
                android:textColor="#010B13"
                android:textSize="22sp" />

            <WebView
                android:id="@+id/chartWater"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <!-- Seção Gráfico: Energia -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="-0.06"
                android:text="Energia"
                android:textColor="#010B13"
                android:textSize="22sp" />

            <WebView
                android:id="@+id/chartEnergy"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:overScrollMode="never"
                android:scrollbars="none" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.ouros.app.core.SkeletonLoaderView
        android:id="@+id/dashboardLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:contentDescription="Carregando dashboard"
        android:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/dashboardError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#3D4148"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboardRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tentar novamente"
            android:textAllCaps="false"
            android:visibility="gone"
            app:backgroundTint="#17134F"
            app:cornerRadius="12dp" />

    </LinearLayout>

</FrameLayout>
