<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F9">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="96dp"
        android:scrollbars="none"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Consumo"
                android:textColor="#101318"
                android:textSize="18sp"
                android:textStyle="bold" />

            <WebView
                android:id="@+id/chartConsumption"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="Água"
                android:textColor="#101318"
                android:textSize="18sp"
                android:textStyle="bold" />

            <WebView
                android:id="@+id/chartWater"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="Energia"
                android:textColor="#101318"
                android:textSize="18sp"
                android:textStyle="bold" />

            <WebView
                android:id="@+id/chartEnergy"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:overScrollMode="never"
                android:scrollbars="none" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.ouros.app.core.SkeletonLoaderView
        android:id="@+id/dashboardLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4F7F9"
        android:contentDescription="Carregando dashboard"
        android:visibility="visible" />

    <TextView
        android:id="@+id/dashboardNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="20dp"
        android:background="#FFF4D5"
        android:padding="12dp"
        android:textColor="#654B00"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/dashboardError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#3D4148"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboardRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tentar novamente"
            android:textAllCaps="false"
            android:visibility="gone"
            app:backgroundTint="#17134F"
            app:cornerRadius="12dp" />

    </LinearLayout>

</FrameLayout>