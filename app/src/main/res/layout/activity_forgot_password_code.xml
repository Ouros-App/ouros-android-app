<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.auth.forgotpassword.ForgotPasswordActivity">

    <TextView
        android:id="@+id/header"
        style="@style/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="Código"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="25dp"
        android:contentDescription="Voltar"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/header"
        app:srcCompat="@drawable/ic_arrow_left" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-20dp"
        android:layout_marginTop="5dp"
        android:contentDescription="Asas de Ouros"
        app:layout_constraintStart_toEndOf="@id/header"
        app:layout_constraintTop_toTopOf="@id/header"
        app:srcCompat="@drawable/ouros_goldwings" />

    <LinearLayout
        android:id="@+id/forgotCodeContentContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:id="@+id/codeTexts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="72dp"
            android:layout_marginEnd="50dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCodeTitle"
                style="@style/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agora, o código de verificação!" />

            <TextView
                android:id="@+id/textCodeDescription"
                style="@style/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enviamos um código temporário para o e-mail registrado." />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/codeInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="70dp"
            android:layout_marginEnd="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCodeDigitOne"
                    style="@style/Widget.Ouros.VerificationCodeInput"
                    android:autofillHints="smsOTPCode"
                    android:importantForAutofill="yes" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCodeDigitTwo"
                    style="@style/Widget.Ouros.VerificationCodeInput"
                    android:importantForAutofill="no" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCodeDigitThree"
                    style="@style/Widget.Ouros.VerificationCodeInput"
                    android:importantForAutofill="no" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCodeDigitFour"
                    style="@style/Widget.Ouros.VerificationCodeInput"
                    android:importantForAutofill="no" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCodeDigitFive"
                    style="@style/Widget.Ouros.VerificationCodeInput"
                    android:importantForAutofill="no" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Ouros.VerificationCodeBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCodeDigitSix"
                    style="@style/Widget.Ouros.VerificationCodeInput"
                    android:importantForAutofill="no" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/textCodeError"
            style="@style/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp"
            android:textColor="@color/warning_red"
            android:visibility="gone"
            tools:text="Informe os 6 números do código."
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnContinue"
            style="@style/Widget.Ouros.Button.Big.Blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="30dp"
            android:text="Continuar" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnResendCode"
        style="@style/text"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="Reenviar código"
        android:textColor="@color/blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
